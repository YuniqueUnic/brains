#pragma xidlc package Brains HTTP API
#pragma xidlc version v1
#pragma xidlc service http://127.0.0.1:45800 localhost

// ---------------------------------------------------------------------------
// Brains wire contract (design §11): the source of truth for SDKs and the
// OpenAPI document. Both the axum server (crates/api-http) and the Rust/TS
// SDKs are generated from this file.
//
// Error channel (xidl #294): operations declare `raises(...)`; each
// exception carries an HTTP status via `@http(N)`, optional response
// headers (the ETag on 304/410/412) and the shared `{"error": ErrorDetail}`
// body. Statuses an operation does not raise are still possible at the
// framework edges (malformed input never reaches a handler, authentication
// is enforced by middleware) and surface as generic transport errors.
//
// Representation switching (xidl #296): `GET /file` and `GET /revision`
// return `@http` unions — JSON metadata or raw bytes — negotiated per
// response Content-Type. The `format` query param keeps its historical
// meaning (`raw` default) as the server-side selector; `Accept` must
// include the served media type or the server answers 406.
//
// Authentication is enforced by server middleware (design §15): Bearer
// tokens or signed session cookies authenticate every route; cookie-driven
// mutations additionally pass the CSRF/Origin guard. The IDL therefore
// models neither and clients attach credentials out of band.
// ---------------------------------------------------------------------------

module brains {

struct CapabilityLimits {
    uint64 max_text_bytes;
    uint64 max_attachment_bytes;
};

enum Runtime {
    // Wire values are kebab-case (historical); variant idents are idiomatic.
    @rename("local-rust")
    LocalRust,
    @rename("cloudflare-rust")
    CloudflareRust,
    @rename("cloudflare-typescript")
    CloudflareTypescript,
};

struct SemanticCapability {
    string model_id;
    uint64 dimensions;
    int64 vector_index_version;
    @optional string unavailable_reason;
};

// Document conversion of this instance (issue #19): absent when the build
// ships no converter; otherwise converter identity and supported types.
@optional struct DocumentConversion {
    string converter;
    string version;
    sequence<string> media_types;
};

struct Capabilities {
    // Product version and Git metadata of the running instance, not the client.
    string build_version;
    string api_version;
    uint64 store_format;
    Runtime runtime;
    CapabilityLimits limits;
    map<string, boolean> features;
    // Semantic search projection state (issue #17): active model, dimensions
    // and index version, or an explicit reason when unavailable.
    @optional SemanticCapability semantic;
    // Document conversion (issue #19); absent = unavailable.
    @optional DocumentConversion document_conversion;
    @optional string vault;
};

struct Generated {
    string by;
    @optional string at;
};

struct Verification {
    string by;
    @optional string at;
};

struct SourceRef {
    string id;
    @optional string resource;
    @optional string title;
    @optional string last_modified;
};

// Derived, never authoritative: parsed frontmatter fields plus the computed
// trust tier. `stale_after` stays a date; staleness is computed at query
// time against the server's clock.
struct NoteMeta {
    @optional string type;
    @optional string description;
    string status;            // draft | stable | deprecated
    string trust;             // unverified | machine-confirmed | human-reviewed
    @optional string stale_after;
    @optional Generated generated;
    sequence<Verification> verified;
    sequence<SourceRef> sources;
};

struct Entry {
    string path;
    string revision;
    int64 generation;
    string state;
    @optional string updated_at;
    @optional int64 size;
    @optional string sha256;
    @optional string media_type;
    @optional string kind;
    @optional string title;
    // Lifecycle/trust projection (index source and metadata reads; absent
    // when the serving path has none).
    @optional NoteMeta meta;
};

struct PurgeResult {
    string path;
    boolean purged;
    string index_state;
    string operation_id;
};

struct MutationResult {
    string path;
    string revision;
    int64 generation;
    string state;
    @optional string updated_at;
    @optional int64 size;
    @optional string sha256;
    @optional string media_type;
    @optional string kind;
    @optional string title;
    string index_state;
    string operation_id;
    // Create-vs-replace is answered in-band (the success status is fixed at
    // 200 by the generated transport).
    @optional boolean created;
};

struct FilePage {
    sequence<Entry> items;
    @optional string next_cursor;
    string source;
    string consistency;
};

struct ContentRef {
    int64 size;
    string sha256;
    string media_type;
    boolean executable;
};

struct CopiedFrom {
    string path;
    string revision;
};

struct Revision {
    string revision;
    string path;
    int64 generation;
    @optional string parent;
    string action;
    @optional string actor;
    @optional string operation_id;
    string created_at;
    @optional string restores_revision;
    @optional CopiedFrom copied_from;
    @optional string commit_state;
    @optional ContentRef content;
};

// Lossless, administrative archive records (ordinary Revision omits keys).
struct ArchiveContent {
    string key;
    string sha256;
    int64 size;
    string media_type;
    boolean executable;
};
// HTTP optionals omit absent fields; storage/archive files keep their own encoding.
struct ArchiveRevision {
    uint64 schema_version;
    string revision;
    string path;
    int64 generation;
    @optional string parent;
    string action;
    string actor;
    string operation_id;
    string created_at;
    @optional string restores_revision;
    @optional CopiedFrom copied_from;
    @optional ArchiveContent content;
};
struct ArchiveHead {
    uint64 schema_version;
    string path;
    string revision;
    int64 generation;
    string state;
    string updated_at;
};
struct ArchivePublished {
    ArchiveHead head;
    string index_state;
};
struct ArchiveBlobStored { boolean stored; };

struct HistoryPage {
    sequence<Revision> items;
    string anchor_revision;
    @optional string next_cursor;
};

// One retriever's view of a hybrid hit (issue #18): name and 1-based rank.
struct Retrieval {
    string retriever;
    uint64 rank;
};

struct SearchHit {
    string path;
    string indexed_revision;
    string snippet;
    // Hybrid mode only: which retrievers matched, with the rank in each.
    sequence<Retrieval> retrieved_by;
};

struct SearchPage {
    sequence<SearchHit> items;
    @optional string next_cursor;
    boolean complete;
    int64 scanned;
    string index_state;
    // Hybrid mode only: retrievers that did not contribute and why
    // ("fts", "semantic", …) — reported instead of pretending completeness.
    sequence<string> unavailable;
};

struct LinkItem {
    string source;
    string target;
    string kind;
    @optional string source_revision;
};

struct LinkPage {
    sequence<LinkItem> items;
    @optional string next_cursor;
};

struct ReindexRequest {
    @optional string cursor;
    @optional int64 limit;
};

struct ReindexFailure {
    string path;
    string code;
};

struct ReindexPage {
    int64 processed;
    sequence<ReindexFailure> failed;
    @optional string next_cursor;
};

struct Session {
    string actor;
    sequence<string> scopes;
    @optional string expires_at;
    @optional string csrf_token;
};

struct OkResult {
    boolean ok;
};

struct PatchEdit {
    string old_text;
    string new_text;
    int64 expected_matches;
};

struct PatchBody {
    sequence<PatchEdit> edits;
    @optional boolean dry_run;
};

struct RestoreBody {
    string path;
    string revision;
};

struct TransferBody {
    string source;
    string target;
    string expected_source_revision;
    string operation_id;
};

struct ErrorDetail {
    string code;
    string message;
    string request_id;
    @optional string path;
    @optional string current_revision;
};

struct TransferResult {
    boolean copied;
    boolean source_trashed;
    boolean partial;
    string operation_id;
    @optional string target_revision;
    @optional string source_revision;
    @optional ErrorDetail error;
};

struct DiffResult {
    string diff;
};

// -- Error vocabulary -------------------------------------------------------

// Every successful patch returns its preview and an optional committed mutation.
// This mirrors the application result; dry-run leaves committed absent.
struct PatchResult {
    string diff;
    string base_revision;
    @optional MutationResult committed;
};
// Bodies mirror the server's `ErrorBody` envelope exactly: `{"error": ...}`.
// 410/412 carry the current HEAD ETag so clients can rebase; 304 carries the
// unchanged ETag and, per RFC 9110, no body.

@http(400)
exception BadRequest {
    ErrorDetail error;
};

@http(403)
exception Forbidden {
    ErrorDetail error;
};

@http(404)
exception NotFound {
    ErrorDetail error;
};

@http(409)
exception Conflict {
    ErrorDetail error;
};

@http(410)
exception Gone {
    ErrorDetail error;
    @header @rename("ETag") @optional string etag;
};

@http(412)
exception PreconditionFailed {
    ErrorDetail error;
    @header @rename("ETag") @optional string etag;
};

@http(413)
exception PayloadTooLarge {
    ErrorDetail error;
};

@http(422)
exception UnprocessableEntity {
    ErrorDetail error;
};

@http(428)
exception PreconditionRequired {
    ErrorDetail error;
};

@http(500)
exception Internal {
    ErrorDetail error;
};

@http(501)
exception NotImplemented {
    ErrorDetail error;
};

@http(503)
exception ServiceUnavailable {
    ErrorDetail error;
};

@http(304)
exception NotModified {
    @header @rename("ETag") string etag;
};

// A partially failed transfer answers 409 with a TransferResult-shaped body
// (the outcome is data, not an error envelope). The exception mirrors those
// members so the wire stays byte-identical while clients can match the case.
@http(409)
exception TransferConflict {
    boolean copied;
    boolean source_trashed;
    boolean partial;
    string operation_id;
    @optional string target_revision;
    @optional string source_revision;
    @optional ErrorDetail error;
};

// HEAD has no body; failures expose their code through a response header.
@http(400)
exception HeadBadRequest {
    @header @rename("X-Brain-Error-Code") string code;
};

@http(403)
exception HeadForbidden {
    @header @rename("X-Brain-Error-Code") string code;
};

@http(404)
exception HeadNotFound {
    @header @rename("X-Brain-Error-Code") string code;
};

@http(410)
exception HeadGone {
    @header @rename("X-Brain-Error-Code") string code;
    @header @rename("ETag") @optional string etag;
};

@http(503)
exception HeadServiceUnavailable {
    @header @rename("X-Brain-Error-Code") string code;
};

@http(500)
exception HeadInternal {
    @header @rename("X-Brain-Error-Code") string code;
};

// -- Representation switching ----------------------------------------------
// ContentType is built into xidl; the discriminator travels as the
// response Content-Type, never on the wire as a tag.

// GET /file: current-HEAD metadata or the raw bytes.
@http
union FilePayload switch (ContentType) {
    case Json: Entry meta;
    case OctetStream: sequence<octet> raw;
};

// GET /revision: one immutable revision's metadata or its raw bytes.
@http
union RevisionPayload switch (ContentType) {
    case Json: Revision meta;
    case OctetStream: sequence<octet> raw;
};

// Query filters are JSON values: tags are exact strings and combine with AND.
struct ListFilesQuery {
    @optional string source;
    @optional string prefix;
    @optional int64 limit;
    @optional string cursor;
    @optional sequence<string> tags;
    @optional string kind;
    @optional string sort;
    @optional boolean include_deleted;
    // Lifecycle/trust filters (index source only, issue #13).
    @optional string status;   // draft | stable | deprecated
    @optional string type;
    @optional string trust;    // unverified | machine-confirmed | human-reviewed
    @optional boolean stale;   // true = only stale, false = only fresh
};
struct SearchQuery {
    string q;
    @optional string mode;
    @optional string prefix;
    @optional sequence<string> tags;
    // Lifecycle/trust filters, applied to literal and fts alike (issue #13).
    @optional string status;
    @optional string type;
    @optional string trust;
    @optional boolean stale;
    @optional int64 scan_limit;
    @optional string cursor;
};

// Request bodies are inline (the JSON document is the value itself, no
// envelope), so every struct body is declared `@flatten`.
// Shared mutation headers. `If-Match`/`If-None-Match` carry STRONG revision
// ETags; `*` on If-None-Match means create-only. `X-Operation-ID` correlates
// revisions with client operations; retries still require a matching ETag.

// Auth is enforced by middleware (Bearer or session cookie; CSRF for
// cookie-driven mutations), so the interface declares no scheme.
@no_security
interface Files {
    // Instance capabilities and limits.
    @get(path = "/capabilities")
    Capabilities capabilities();

    // Listing. source=store is the authoritative HEAD scan; source=index adds
    // tag/kind filters and updated_desc order. Cursors are opaque + signed:
    // echo them back unchanged or the server answers 400.
    @post(path = "/files/query")
    FilePage list_files(@flatten in ListFilesQuery body) raises(BadRequest, Forbidden, ServiceUnavailable, Internal);

    // Create or conditionally replace one file's exact bytes (design §8.2).
    // Raw body = application/octet-stream; text media types are declared via
    // Content-Type. Success is 200 with created in-band; CAS loss is 412.
    @put(path = "/file")
    MutationResult put_file(
        @query string path,
        @header @rename("If-Match") @optional string if_match,
        @header @rename("If-None-Match") @optional string if_none_match,
        @header @rename("X-Operation-ID") @optional string operation_id,
        @header @rename("X-Content-SHA256") @optional string content_sha256,
        // Omitted preserves the existing executable flag.
        @header @rename("X-Executable") @optional boolean executable,
        @header @rename("Content-Type") @optional string content_type,
        @header @rename("ETag") @optional out string etag,
        in sequence<octet> body
    ) raises(BadRequest, Forbidden, Gone, PreconditionRequired, PreconditionFailed, PayloadTooLarge, UnprocessableEntity, ServiceUnavailable, Internal);

    // Current-HEAD read: JSON metadata (`format=meta`) or raw bytes
    // (`format` omitted). Both views answer If-None-Match with 304 + ETag;
    // 410 once the path is trashed. The response Content-Type selects the
    // union case; `Accept` must include it.
    @get(path = "/file")
    FilePayload get_file(
        @query string path,
        @query @rename("format") @optional string format,
        @header @rename("If-None-Match") @optional string if_none_match,
        @header @rename("ETag") @optional out string etag,
        @header @rename("X-Brain-Media-Type") @optional out string media_type,
        @header @rename("Content-Disposition") @optional out string content_disposition
    ) raises(BadRequest, Forbidden, NotFound, Gone, NotModified, ServiceUnavailable, Internal);

    // Metadata-only probe: never fetch the content blob.
    @head(path = "/file")
    void head_file(
        @query string path,
        @header @rename("ETag") out string etag,
        @header @rename("X-Brain-Generation") out int64 generation,
        @header @rename("X-Brain-State") out string state
    ) raises(HeadBadRequest, HeadForbidden, HeadNotFound, HeadGone, HeadServiceUnavailable, HeadInternal);

    // Conditional delete: writes a tombstone revision. 412 on stale base.
    @delete(path = "/file")
    MutationResult delete_file(
        @query string path,
        @header @rename("If-Match") @optional string if_match,
        @header @rename("X-Operation-ID") @optional string operation_id,
        @header @rename("ETag") @optional out string etag
    ) raises(BadRequest, Forbidden, NotFound, Gone, PreconditionRequired, PreconditionFailed, ServiceUnavailable, Internal);

    // Permanently remove a tombstoned path; live files fail with 409.
    @delete(path = "/trash")
    PurgeResult purge_file(
        @query string path,
        @header @rename("If-Match") @optional string if_match,
        @header @rename("X-Operation-ID") @optional string operation_id
    ) raises(BadRequest, Forbidden, NotFound, Conflict, PreconditionRequired, PreconditionFailed, ServiceUnavailable, Internal);

    // Patch text in place. Dry-run previews the same edits without changing
    // HEAD; committed contains the new mutation only after a successful write.
    @patch(path = "/file")
    PatchResult patch_file(
        @query string path,
        @header @rename("If-Match") @optional string if_match,
        @header @rename("X-Operation-ID") @optional string operation_id,
        @header @rename("ETag") @optional out string etag,
        @flatten in PatchBody body
    ) raises(BadRequest, Forbidden, NotFound, Gone, Conflict, PreconditionRequired, PreconditionFailed, PayloadTooLarge, UnprocessableEntity, ServiceUnavailable, Internal);

    // Reachable history of one path, newest first (signed cursor pages).
    @get(path = "/revisions")
    HistoryPage list_revisions(
        @query string path,
        @query @optional int64 limit,
        @query @optional string cursor
    ) raises(BadRequest, Forbidden, NotFound, Gone, ServiceUnavailable, Internal);

    // One immutable revision by ID: metadata (`format=meta`) or raw bytes.
    @get(path = "/revision")
    RevisionPayload get_revision(
        @query string path,
        @query string revision,
        @query @rename("format") @optional string format,
        @header @rename("ETag") @optional out string etag,
        @header @rename("X-Brain-Media-Type") @optional out string media_type,
        @header @rename("Content-Disposition") @optional out string content_disposition
    ) raises(BadRequest, Forbidden, NotFound, Gone, ServiceUnavailable, Internal);

    // Restore a prior revision's content as a NEW revision (gen only moves
    // forward). If-Match anchors on the current head.
    @post(path = "/restore")
    MutationResult restore(
        @header @rename("If-Match") @optional string if_match,
        @header @rename("X-Operation-ID") @optional string operation_id,
        @header @rename("ETag") @optional out string etag,
        @flatten in RestoreBody body
    ) raises(BadRequest, Forbidden, NotFound, Gone, PreconditionRequired, PreconditionFailed, ServiceUnavailable, Internal);

    // Literal (case-sensitive UTF-8 substring) or FTS (tokenized) search.
    @post(path = "/search")
    SearchPage search(@flatten in SearchQuery body) raises(BadRequest, Forbidden, NotImplemented, ServiceUnavailable, Internal);

    // Wiki-link graph induced by [[links]] in stored text. Pages are fixed
    // at 50 rows; `cursor` walks the rest.
    @get(path = "/links")
    LinkPage links(
        @query string path,
        @query @rename("direction") @optional string direction,
        @query @optional string cursor
    ) raises(BadRequest, Forbidden, ServiceUnavailable, Internal);

    // Copy: create target from a source revision; source stays live. A
    // partially failed transfer answers TransferConflict (409) whose body
    // is the outcome report.
    @post(path = "/copy")
    TransferResult copy(
        @flatten in TransferBody body
    ) raises(BadRequest, Forbidden, NotFound, Gone, PreconditionFailed, TransferConflict, UnprocessableEntity, ServiceUnavailable, Internal);

    // Move: copy + trash source; partial outcomes are TransferConflict (409),
    // never hidden.
    @post(path = "/move")
    TransferResult move(
        @flatten in TransferBody body
    ) raises(BadRequest, Forbidden, NotFound, Gone, PreconditionFailed, TransferConflict, UnprocessableEntity, ServiceUnavailable, Internal);

    // Unified diff between two revisions of one path.
    @get(path = "/diff")
    DiffResult diff(
        @query string path,
        @query string from,
        @query string to
    ) raises(BadRequest, Forbidden, NotFound, ServiceUnavailable, Internal);

    // Paged index rebuild from authoritative storage (safe anytime).
    @post(path = "/maintenance/reindex")
    ReindexPage reindex(
        @flatten in ReindexRequest body
    ) raises(BadRequest, Forbidden, ServiceUnavailable, Internal);

    // Reserved server-side consistency check; answers 501 until delivered
    // (design §22.5).
    @post(path = "/maintenance/validate")
    void validate() raises(NotImplemented);
};

// Authentication and cookie mutation protection share Files middleware.
@no_security
interface Archives {
    // Administrative archive transport. HTTP optional fields are omitted when
    // absent; immutable storage records are converted at the service boundary.
    @get(path = "/maintenance/archive/revision")
    ArchiveRevision archive_revision(@query string path, @query string revision)
        raises(BadRequest, Forbidden, NotFound, UnprocessableEntity, ServiceUnavailable, Internal);

    @post(path = "/maintenance/archive/revision")
    ArchiveRevision import_archive_revision(@flatten in ArchiveRevision body)
        raises(BadRequest, Forbidden, PreconditionFailed, PayloadTooLarge, UnprocessableEntity, ServiceUnavailable, Internal);

    @put(path = "/maintenance/archive/blob")
    ArchiveBlobStored import_archive_blob(
        @query string path, @query string revision, in sequence<octet> body
    ) raises(BadRequest, Forbidden, NotFound, PayloadTooLarge, UnprocessableEntity, ServiceUnavailable, Internal);

    // Publish exactly one source generation with CAS; reindex after replay.
    @post(path = "/maintenance/archive/head")
    ArchivePublished import_archive_head(@query string path, @query string revision)
        raises(BadRequest, Forbidden, NotFound, PreconditionFailed, UnprocessableEntity, ServiceUnavailable, Internal);

};

// Session exchange for browser flows: token -> signed cookie + CSRF token.
// The cookie itself rides the `Set-Cookie` response header. API agents can
// ignore this interface and use bearer tokens throughout. (The interface is
// named `Sessions` because the generated server module shares one namespace
// with payload structs, and `Session` names the payload.)
@no_security
interface Sessions {
    @post(path = "/session")
    Session login(
        @header string authorization,
        @header @rename("Set-Cookie") @optional out string set_cookie
    ) raises(BadRequest, Forbidden, Internal);

    @get(path = "/session")
    Session current();

    @delete(path = "/session")
    OkResult logout(
        @header @rename("Set-Cookie") @optional out string set_cookie
    );
};

};
