# Copy to .env, then run pnpm cloudflare:init to generate private instance keys.
# The root .env is ignored by Git. Never upload this entire file as Worker secrets.
# Optional with local Wrangler OAuth login; required for GitHub Actions.
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=

# Create dedicated R2/D1 resources once; paste the actual D1 ID here.
BRAINS_WORKER_NAME=brains
BRAINS_R2_BUCKET=brains-data
BRAINS_D1_DATABASE=brains-index
BRAINS_D1_DATABASE_ID=
BRAINS_BASE_URL=

# Optional custom domain; use its HTTPS origin as BRAINS_BASE_URL.
BRAINS_CUSTOM_DOMAIN=
BRAINS_CUSTOM_DOMAIN_ZONE_ID=

# Worker runtime settings; optional cloud services are composed below.
VAULT_ID=default
# Text indexing threshold: 256 KiB. Larger files can still be stored.
MAX_TEXT_BYTES=262144
# Stored content limit: 8 MiB, including content that is not indexed.
MAX_ATTACHMENT_BYTES=8388608
# Comma-separated origins for cross-origin cookie clients; empty is same-origin only.
ALLOWED_ORIGINS=
# Set on after configuring an AI Search instance and resource policy.
SEMANTIC_SEARCH=off

# Optional structured configuration. Use a file OR inline JSON for each setting.
# Copy examples to a private location and set the actual billing-cycle bounds.
# Files are loaded locally; their contents become Worker vars. No external key
# is needed for the default Qwen/1024 AI Search model.
BRAINS_CLOUD_CONFIG_FILE=
BRAINS_RESOURCE_PROFILE_FILE=
BRAINS_AI_SEARCH_NAMESPACE=default
BRAINS_RECONCILE_CRON='*/5 * * * *'
# Account identity defaults to CLOUDFLARE_ACCOUNT_ID, not the Worker name.
BRAINS_RESOURCE_ACCOUNT=

# Deployment setting: apply pending D1 schema migrations before uploading code.
BRAINS_APPLY_MIGRATIONS=true

# cloudflare:init fills these placeholders in the private .env once.
# Keep the generated values across deployments; this template contains no secrets.
# Plaintext admin login token for the web app and client.
BRAINS_ADMIN_TOKEN=
# Token hashes, permissions and enabled flags used by the Worker.
TOKEN_REGISTRY_JSON=
# Different 32-byte keys encoded as 64 hex characters.
SESSION_SIGNING_KEY=
CURSOR_SIGNING_KEY=

# Dedicated AI Gateway for the upload-only AI Search instance. Core inference
# calls managed by AI Search are included there, not charged again as Workers AI.
BRAINS_AI_GATEWAY_ID=brains-notes

# Optional read-only MCP adapter. cloudflare:mcp-init generates separate tokens.
# Deploy the core registry first, then cloudflare:mcp-deploy. Configure an
# owner-only Access portal using docs/cloudflare-mcp.md before sharing access.
BRAINS_MCP_READ_PREFIX=/
BRAINS_MCP_WORKER_NAME=
BRAINS_MCP_HOSTNAME=
BRAINS_MCP_API_TOKEN=
BRAINS_MCP_ACCESS_TOKEN=
