{
  "name": "brains",
  "private": true,
  "packageManager": "pnpm@10.28.2",
  "version": "0.7.0",
  "scripts": {
    "cloudflare:init": "python3 scripts/cloudflare.py init",
    "cloudflare:sync-admin-token": "python3 scripts/cloudflare.py sync-admin-token",
    "cloudflare:github-configure": "python3 scripts/cloudflare.py github-configure",
    "cloudflare:check": "python3 scripts/cloudflare.py check",
    "cloudflare:deploy": "python3 scripts/cloudflare.py deploy",
    "cloudflare:verify": "python3 scripts/cloudflare.py verify",
    "cloudflare:wrangler": "python3 scripts/cloudflare.py wrangler",
    "mcp:check": "pnpm --filter brains-mcp check",
    "lint": "oxlint --deny-warnings apps/web/src apps/web/vite.config.ts apps/mcp/src apps/mcp/scripts crates/adapter-cloudflare/src/bindings.js tests/e2e tests/http-sdk scripts",
    "cloudflare:provision": "python3 scripts/cloudflare.py provision",
    "cloudflare:mcp-init": "python3 scripts/cloudflare.py mcp-init",
    "cloudflare:mcp-check": "python3 scripts/cloudflare.py mcp-check",
    "cloudflare:mcp-deploy": "python3 scripts/cloudflare.py mcp-deploy",
    "worker:check": "pnpm --filter brains-worker check",
    "cloudflare:mcp-verify": "python3 scripts/cloudflare.py mcp-verify"
  },
  "devDependencies": {
    "oxlint": "^1.89.0"
  }
}
